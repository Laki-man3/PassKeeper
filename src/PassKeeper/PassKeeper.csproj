<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PassKeeper</AssemblyName>
    <RootNamespace>PassKeeper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PassKeeper.ico</ApplicationIcon>
    <StartupObject>PassKeeper.Program</StartupObject>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Offline product: no telemetry, no update checks, invariant globalization not used (RU/EN UI). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share type names; keep WinForms out of implicit usings (only NotifyIcon is used). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PassKeeper.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Custom Main (Program.cs): single instance, installer/uninstaller modes. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\InstallLayout.cs" Link="Shared\InstallLayout.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- User manual shown by Help (works offline). WithCulture=false: "*.ru.md" is not a satellite resource. -->
    <EmbeddedResource Include="..\..\docs\manual.ru.md" LogicalName="manual.ru.md" WithCulture="false" />
    <EmbeddedResource Include="..\..\docs\manual.en.md" LogicalName="manual.en.md" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PassKeeper.Core\PassKeeper.Core.csproj" />
  </ItemGroup>

</Project>
