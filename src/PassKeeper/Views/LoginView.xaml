<UserControl x:Class="PassKeeper.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PassKeeper.Localization"
             xmlns:c="clr-namespace:PassKeeper.Controls">
    <Grid Background="{DynamicResource Brush.PageGlow}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,40,0,0">
            <StackPanel Width="400" VerticalAlignment="Center" Margin="0,24,0,32">
                <Image Source="{StaticResource LogoImage}" Width="68" Height="68" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Text.H1}" Margin="0,22,0,8" Text="{l:T Login.Title}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:T Login.Subtitle}" TextWrapping="Wrap" />

                <TextBlock x:Name="UsersLabel" Style="{StaticResource Text.Label}" Margin="0,22,0,8" Text="{l:T Login.Users}" />
                <WrapPanel x:Name="Users" />

                <TextBlock Style="{StaticResource Text.Label}" Margin="0,16,0,6" Text="{l:T Setup.UserName}" />
                <TextBox x:Name="UserName" MaxLength="64" c:UI.Placeholder="{l:T Login.UserNamePlaceholder}" />

                <TextBlock Style="{StaticResource Text.Label}" Margin="0,14,0,6" Text="{l:T Setup.Master}" />
                <c:SecretBox x:Name="Master" Placeholder="{l:T Unlock.MasterPlaceholder}" />

                <TextBlock x:Name="Error" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Danger}" Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

                <Button x:Name="LoginButton" Style="{StaticResource Btn.Primary}" Height="42" Margin="0,18,0,0" Click="Login_Click" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <Control x:Name="Busy" Style="{StaticResource Spinner}" Margin="0,0,10,0" Visibility="Collapsed" />
                        <TextBlock Text="{l:T Login.Button}" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{l:T Login.PinNote}" />

                <Button x:Name="CreateButton" Style="{StaticResource Btn.Link}" HorizontalAlignment="Center" Margin="0,18,0,0" c:UI.Icon="&#xE8FA;"
                        Content="{l:T Login.Create}" Click="Create_Click" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{l:T Common.OfflineNote}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,28,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LangRu" Style="{StaticResource Segment}" Content="Русский" GroupName="LoginLang" Checked="Lang_Checked" />
                <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" Content="English" GroupName="LoginLang" Checked="Lang_Checked" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
