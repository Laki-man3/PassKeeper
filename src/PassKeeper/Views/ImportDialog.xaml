<local:DialogBase x:Class="PassKeeper.Views.ImportDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PassKeeper.Views"
                  xmlns:l="clr-namespace:PassKeeper.Localization"
                  xmlns:c="clr-namespace:PassKeeper.Controls">
    <Grid>
        <!-- ======================================================== step 1: source -->
        <DockPanel x:Name="SourceStep">
            <Grid DockPanel.Dock="Top" Margin="26,20,18,0">
                <TextBlock Style="{StaticResource Text.H2}" FontSize="18" Text="{l:T Import.Title}" VerticalAlignment="Center" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE711;" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Secondary}" Margin="26,6,26,16" Text="{l:T Import.Subtitle}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="26,0,26,22">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Text.Label}" Margin="0" Text="{l:T Import.Browsers}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Btn.Link}" FontSize="12" HorizontalAlignment="Right" Content="{l:T Import.Refresh}" Click="Refresh_Click" />
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <StackPanel x:Name="BrowserList" />
                            <TextBlock x:Name="NoBrowsers" Style="{StaticResource Text.Muted}" Text="{l:T Import.NoBrowsers}" Visibility="Collapsed" Margin="0,2,0,2" />
                            <Button x:Name="ImportBrowsersButton" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Left" Margin="0,12,0,4"
                                    c:UI.Icon="&#xE774;" Content="{l:T Import.FromBrowsers}" Click="ImportBrowsers_Click" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,18,0,8" Text="{l:T Import.FromFileTitle}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12.5" Text="{l:T Import.Formats}" />
                            <Button Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0" c:UI.Icon="&#xE8E5;" Content="{l:T Import.ChooseFile}" Click="ChooseFile_Click" />
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,10,0,0" Text="{l:T Import.ChromeTip}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,18,0,8" Text="{l:T Import.Other}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <Grid>
                            <StackPanel Margin="0,0,180,0">
                                <TextBlock Text="{l:T Import.WindowsCredentials}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Text.Muted}" Text="{l:T Import.WindowsCredentialsHint}" />
                            </StackPanel>
                            <Button Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" c:UI.Icon="&#xE8D7;" Content="{l:T Import.Read}" Click="WindowsCredentials_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ======================================================== step 2: preview -->
        <DockPanel x:Name="PreviewStep" Visibility="Collapsed">
            <Grid DockPanel.Dock="Top" Margin="26,20,18,0">
                <TextBlock x:Name="PreviewTitle" Style="{StaticResource Text.H2}" FontSize="18" VerticalAlignment="Center" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE711;" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>
            <WrapPanel DockPanel.Dock="Top" Margin="26,10,26,0">
                <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.SuccessSoft}" Margin="0,0,6,6">
                    <TextBlock x:Name="NewCount" FontSize="12" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold" />
                </Border>
                <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.WarningSoft}" Margin="0,0,6,6">
                    <TextBlock x:Name="ConflictCount" FontSize="12" Foreground="{DynamicResource Brush.Warning}" FontWeight="SemiBold" />
                </Border>
                <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,6,6">
                    <TextBlock x:Name="DuplicateCount" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" />
                </Border>
            </WrapPanel>

            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="26,14">
                <Grid>
                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" c:UI.Icon="&#xE72B;" Content="{l:T Common.Back}" Click="Back_Click" />
                    <Button x:Name="ApplyButton" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Right" MinWidth="160" Click="Apply_Click" />
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Margin="26,10,26,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:T Import.TargetFolder}" />
                        <ComboBox x:Name="TargetFolder" IsEditable="True" c:UI.Placeholder="{l:T Import.NoFolder}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:T Import.Conflicts}" />
                        <ComboBox x:Name="ConflictMode" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="WarningsPanel" DockPanel.Dock="Top" Margin="26,6,26,0" />

            <Grid DockPanel.Dock="Top" Margin="26,10,26,6">
                <CheckBox x:Name="SelectAll" Content="{l:T Import.SelectAll}" Click="SelectAll_Click" />
                <TextBox x:Name="Filter" Width="200" MinHeight="30" Height="30" HorizontalAlignment="Right" c:UI.Placeholder="{l:T Import.Filter}" TextChanged="Filter_TextChanged" />
            </Grid>

            <Border Margin="26,0,26,0" Style="{StaticResource Card}" Padding="4">
                <ListBox x:Name="CandidateList" Style="{StaticResource List.Plain}" MinHeight="120">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Item.Card}">
                            <Setter Property="Margin" Value="2,1" />
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <c:Avatar Grid.Column="1" SourceText="{Binding Title}" Size="30" />
                                <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="3" Style="{StaticResource Badge}" Background="{Binding StatusBackground}">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusForeground}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- ======================================================== busy -->
        <Grid x:Name="BusyLayer" Background="{DynamicResource Brush.Surface}" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Control Style="{StaticResource Spinner}" Width="34" Height="34" Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock x:Name="BusyText" Style="{StaticResource Text.Secondary}" Margin="0,14,0,0" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</local:DialogBase>
