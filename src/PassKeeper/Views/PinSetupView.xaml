<UserControl x:Class="PassKeeper.Views.PinSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PassKeeper.Localization"
             xmlns:c="clr-namespace:PassKeeper.Controls">
    <Grid Background="{DynamicResource Brush.PageGlow}">
        <StackPanel Width="380" VerticalAlignment="Center" Margin="0,40,0,0">
            <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" FontSize="28" Foreground="{DynamicResource Brush.AccentText}" />
            </Border>
            <TextBlock Style="{StaticResource Text.H1}" TextAlignment="Center" Margin="0,20,0,8" Text="{l:T Pin.Title}" />
            <TextBlock Style="{StaticResource Text.Secondary}" TextAlignment="Center" Text="{l:T Pin.Subtitle}" />

            <TextBlock Style="{StaticResource Text.Label}" Margin="0,26,0,6" Text="{l:T Pin.New}" />
            <PasswordBox x:Name="Pin" Style="{StaticResource PasswordBox.Pin}" PreviewTextInput="Digits_PreviewTextInput" />
            <TextBlock Style="{StaticResource Text.Label}" Margin="0,14,0,6" Text="{l:T Pin.Repeat}" />
            <PasswordBox x:Name="Confirm" Style="{StaticResource PasswordBox.Pin}" PreviewTextInput="Digits_PreviewTextInput" />
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0" TextAlignment="Center" Text="{l:T Pin.Hint}" />

            <TextBlock x:Name="Error" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Danger}" TextAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" />

            <Button x:Name="SaveButton" Style="{StaticResource Btn.Primary}" Height="42" Margin="0,18,0,0" Click="Save_Click" IsDefault="True">
                <StackPanel Orientation="Horizontal">
                    <Control x:Name="Busy" Style="{StaticResource Spinner}" Margin="0,0,10,0" Visibility="Collapsed" />
                    <TextBlock Text="{l:T Pin.Save}" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource Btn.Ghost}" Margin="0,8,0,0" HorizontalAlignment="Center" Content="{l:T Common.Cancel}" Click="Cancel_Click" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
