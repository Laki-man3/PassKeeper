<UserControl x:Class="PassKeeper.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PassKeeper.Localization"
             xmlns:c="clr-namespace:PassKeeper.Controls">
    <Grid Background="{DynamicResource Brush.PageGlow}">

        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,28,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LangRu" Style="{StaticResource Segment}" Content="Русский" GroupName="SetupLang" Checked="Lang_Checked" />
                <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" Content="English" GroupName="SetupLang" Checked="Lang_Checked" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,40,0,0">
            <StackPanel Width="420" VerticalAlignment="Center" Margin="0,24,0,32">
                <Image Source="{StaticResource LogoImage}" Width="68" Height="68" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Text.H1}" Margin="0,22,0,8" Text="{l:T Setup.Title}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{l:T Setup.Subtitle}" />

                <TextBlock Style="{StaticResource Text.Label}" Margin="0,26,0,6" Text="{l:T Setup.UserName}" />
                <TextBox x:Name="UserName" MaxLength="64" c:UI.Placeholder="{l:T Setup.UserNamePlaceholder}" />

                <TextBlock Style="{StaticResource Text.Label}" Margin="0,16,0,6" Text="{l:T Setup.Master}" />
                <c:SecretBox x:Name="Master" Placeholder="{l:T Setup.MasterPlaceholder}" />
                <c:StrengthMeter Margin="0,8,0,0" Password="{Binding Value, ElementName=Master}" />

                <TextBlock Style="{StaticResource Text.Label}" Margin="0,14,0,6" Text="{l:T Setup.Confirm}" />
                <c:SecretBox x:Name="Confirm" Placeholder="{l:T Setup.ConfirmPlaceholder}" />

                <CheckBox x:Name="Autostart" Margin="0,18,0,0" IsChecked="True" Content="{l:T Setup.Autostart}" />

                <Border Margin="0,18,0,0" Padding="12,10" CornerRadius="10" Background="{DynamicResource Brush.WarningSoft}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="15" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,1,10,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" FontSize="12.5" Text="{l:T Setup.Warning}" />
                    </Grid>
                </Border>

                <TextBlock x:Name="Error" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Danger}" Margin="0,14,0,0" Visibility="Collapsed" />

                <Button x:Name="CreateButton" Style="{StaticResource Btn.Primary}" Height="42" Margin="0,18,0,0" Click="Create_Click" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <Control x:Name="Busy" Style="{StaticResource Spinner}" Margin="0,0,10,0" Visibility="Collapsed" />
                        <TextBlock Text="{l:T Setup.Create}" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{l:T Common.OfflineNote}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
