<UserControl x:Class="PassKeeper.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PassKeeper.Localization"
             xmlns:c="clr-namespace:PassKeeper.Controls">
    <Grid x:Name="Root" Background="{DynamicResource Brush.PageGlow}">
        <StackPanel x:Name="Panel" Width="360" VerticalAlignment="Center" Margin="0,40,0,0">
            <Grid HorizontalAlignment="Center">
                <Border x:Name="AvatarBorder" Width="76" Height="76" CornerRadius="24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#7B61FF" />
                            <GradientStop Offset="1" Color="#3D8BFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="Initial" Foreground="White" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.WindowBg}"
                        BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11" Foreground="{DynamicResource Brush.AccentText}" />
                </Border>
            </Grid>
            <TextBlock x:Name="Greeting" Style="{StaticResource Text.H1}" TextAlignment="Center" Margin="0,22,0,6" />
            <TextBlock x:Name="Prompt" Style="{StaticResource Text.Secondary}" TextAlignment="Center" />

            <PasswordBox x:Name="Pin" Style="{StaticResource PasswordBox.Pin}" Margin="0,24,0,0" PreviewTextInput="Pin_PreviewTextInput" KeyDown="Input_KeyDown"
                         c:UI.Placeholder="{l:T Unlock.PinPlaceholder}" />
            <c:SecretBox x:Name="Master" Margin="0,24,0,0" Visibility="Collapsed" Placeholder="{l:T Unlock.MasterPlaceholder}" />

            <TextBlock x:Name="Error" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Danger}" TextAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" />

            <Button x:Name="UnlockButton" Style="{StaticResource Btn.Primary}" Height="42" Margin="0,16,0,0" Click="Unlock_Click">
                <StackPanel Orientation="Horizontal">
                    <Control x:Name="Busy" Style="{StaticResource Spinner}" Margin="0,0,10,0" Visibility="Collapsed" />
                    <TextBlock Text="{l:T Unlock.Button}" />
                </StackPanel>
            </Button>

            <Button x:Name="SwitchMode" Style="{StaticResource Btn.Link}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="SwitchMode_Click" />

            <StackPanel x:Name="Footer" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0" />
                <TextBlock Style="{StaticResource Text.Muted}" Text="{l:T Common.OfflineNote}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
