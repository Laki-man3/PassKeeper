<Window x:Class="PassKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassKeeper" Width="1180" Height="740" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen" Icon="Assets/PassKeeper.ico"
        Background="{DynamicResource Brush.WindowBg}" FontFamily="{StaticResource Font.Ui}" FontSize="13"
        TextElement.Foreground="{DynamicResource Brush.Text}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- title bar of its own: the window is dragged by it, and pages never slide under its buttons -->
        <Border x:Name="TitleBar" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Content="&#xE922;" Click="Maximize_Click" />
                <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" IsTabStop="False" />

        <Grid x:Name="DialogLayer" Grid.RowSpan="2" />

        <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Padding="16,10"
                CornerRadius="10" Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" Color="{DynamicResource Color.Shadow}" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Success}" Text="&#xE73E;" />
                <TextBlock x:Name="ToastText" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
