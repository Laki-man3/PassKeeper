<Project Sdk="Microsoft.NET.Sdk">

  <!-- PassKeeper for macOS and Linux (Avalonia). The Windows version is src/PassKeeper (WPF); both share
       PassKeeper.Core, so the vault and export formats are the same. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PassKeeper</AssemblyName>
    <RootNamespace>PassKeeper.Desktop</RootNamespace>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\PassKeeper.png" LogicalName="PassKeeper.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PassKeeper.Core\PassKeeper.Core.csproj" />
  </ItemGroup>

</Project>
