<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shared by the Windows app and the macOS / Linux app. The few Windows-only parts (DPAPI for the PIN and Chromium
         passwords, the Windows credential store) are only called on Windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PassKeeper.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PassKeeper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>
